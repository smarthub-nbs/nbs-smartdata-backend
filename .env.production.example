DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=api.example.com

DB_NAME=replace-with-managed-database-name
DB_USER=replace-with-managed-database-user
DB_PASSWORD=replace-with-managed-database-password
DB_HOST=replace-with-managed-database-host
DB_PORT=5432
DB_CONN_MAX_AGE=60

CELERY_BROKER_URL=rediss://replace-with-managed-redis-url
CELERY_RESULT_BACKEND=rediss://replace-with-managed-redis-url
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
AUTH_ACCESS_COOKIE_SECURE=True
AUTH_REFRESH_COOKIE_SECURE=True

OPENAI_API_KEY=replace-if-enabled
OPENAI_MODEL=gpt-4.1-mini
GITHUB_OAUTH_CLIENT_ID=replace-if-enabled
GITHUB_OAUTH_CLIENT_SECRET=replace-if-enabled
GITHUB_OAUTH_ALLOWED_REDIRECT_URIS=https://app.example.com/auth/github/callback

FRONTEND_PASSWORD_RESET_URL=https://app.example.com/reset-password
FRONTEND_EMAIL_VERIFICATION_URL=https://app.example.com/verify-email
