# Django core
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Local PostgreSQL database
DB_NAME=smarthub
DB_USER=smarthub
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Email defaults
DEFAULT_FROM_EMAIL=no-reply@smarthub.local

# Dataset upload limits
DATASET_MAX_UPLOAD_SIZE=52428800
DATASET_ALLOWED_FILE_EXTENSIONS=.csv,.json,.pdf,.tsv,.txt,.xls,.xlsx,.xml,.sdmx,.zip

# DRF throttling
DRF_THROTTLE_ANON_RATE=100/hour
DRF_THROTTLE_USER_RATE=1000/day

# JWT settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# Auth cookies
AUTH_ACCESS_COOKIE_NAME=smarthub_access_token
AUTH_ACCESS_COOKIE_SECURE=False
AUTH_ACCESS_COOKIE_SAMESITE=Lax
AUTH_ACCESS_COOKIE_PATH=/api/v1/
AUTH_ACCESS_COOKIE_DOMAIN=

AUTH_REFRESH_COOKIE_NAME=smarthub_refresh_token
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth/
AUTH_REFRESH_COOKIE_DOMAIN=

# Frontend CORS and CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
CORS_ALLOW_CREDENTIALS=True
CORS_PREFLIGHT_MAX_AGE=86400

CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4200
CSRF_COOKIE_NAME=csrftoken
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_PATH=/api/v1/
CSRF_COOKIE_DOMAIN=

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/github/callback,http://localhost:4200/auth/github/callback

# Celery and Redis for local development
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# Account links
PASSWORD_RESET_TOKEN_MAX_AGE=3600
EMAIL_VERIFICATION_TOKEN_MAX_AGE=86400
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password
FRONTEND_EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
